{
    "private": true,
    "scripts": {
        "doc": "cargo doc --workspace --no-deps",
        "test": "cargo test --workspace",
        "fmt": "cargo fmt --all",
        "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
        "p": "git push && git push --tags --prune",
        "u": "cargo upgrade --workspace"
    }
}
